# ---------------------------------------------------------------------------
# tourney-api environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Database (Supabase Free) ----------------------------------------------
# RUNTIME connection: use the Supabase TRANSACTION POOLER endpoint (port 6543).
# The free tier's direct-connection budget is small, so the app pools through
# pgbouncer. Find it in Supabase → Project Settings → Database → Connection
# string → "Transaction" mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# MIGRATION connection: use the DIRECT connection (port 5432). Migrations need
# session features the pooler does not support. Supabase → Database → "Session"
# / "Direct connection".
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Keep small on the free tier.
DB_MAX_CONNS=8

# --- Auth ------------------------------------------------------------------
# Generate a strong secret, e.g.  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of web origins (SvelteKit dev server default below).
CORS_ORIGINS=http://localhost:5173

# --- Seed (used by `make seed`) --------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Super Admin

# --- Auth transition (Phase 5) ---------------------------------------------
# Password login is being replaced by emailed one-time codes. Default is OFF,
# so a deploy cannot silently keep accepting retired credentials. Existing
# argon2id hashes stay in the database, so flipping this back to true is the
# rollback if OTP delivery ever fails — no redeploy, no data restore.
#
# Keep this true LOCALLY until the OTP endpoints ship (subphase 5.4), or you
# will not be able to sign in at all.
AUTH_PASSWORD_LOGIN_ENABLED=true

# --- OTP (Phase 5) ---------------------------------------------------------
# Server-side pepper for hashing one-time codes: HMAC-SHA256(code, OTP_PEPPER).
# NOT argon2id — the password parameters use 64 MiB per hash and this VM has
# 256 MB, which would turn an unauthenticated verify endpoint into a memory
# exhaustion vector. A 6-digit code is defended by its 10-minute TTL, the
# 5-attempt cap and the rate limits; the pepper stops offline brute force by
# anyone who reads the table.
#   openssl rand -base64 48
OTP_PEPPER=replace-with-a-long-random-secret

# --- Plunk (Phase 5, transactional email) ----------------------------------
# Delivery only. This API owns code generation, hashing, expiry, rate limits
# and verification; Plunk just carries the message.
#
# NEVER put PLUNK_API_KEY in Vercel, a PUBLIC_* variable, source, tests or
# logs. It belongs in Fly secrets and this gitignored file, nowhere else.
PLUNK_API_KEY=
PLUNK_FROM_EMAIL=
PLUNK_FROM_NAME=Tourney.social

# Real sends are refused unless APP_ENV=production. This is the deliberate
# override for verifying delivery from a non-production environment — leave it
# unset unless you are actively testing, so a stray test run cannot email a
# real person.
# PLUNK_ALLOW_REAL_SEND=false
